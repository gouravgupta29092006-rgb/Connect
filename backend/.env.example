# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Replace user, password, host, port, and dbname.
# NEVER commit real credentials. Use environment variables in production.
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/connect_db

# Enable SSL for cloud-hosted databases (set to "true" for Render, Railway, etc.
DATABASE_SSL=false

# ─── Authentication ──────────────────────────────────────────────────────────
# JWT signing secret. Must be a long, random string (min 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=YOUR_LONG_RANDOM_SECRET_HERE

# ─── Frontend CORS ───────────────────────────────────────────────────────────
# The URL where your frontend is hosted. Used for CORS and cookie settings.
FRONTEND_URL=http://localhost:3000

# ─── AI — Google Gemini (free tier) ──────────────────────────────────────────
# Get a free API key at: https://aistudio.google.com/app/apikey
# Leave blank to disable AI features (SQL-based matching still works without it)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ─── Firebase Admin SDK (free — Spark plan) ──────────────────────────────────
# Used by the backend to verify Firebase ID tokens from Google Sign-In.
#
# HOW TO GET IT (completely free):
#   1. Go to https://console.firebase.google.com → Your Project
#   2. Click the gear icon → Project Settings → Service Accounts tab
#   3. Click "Generate new private key" → download the JSON file
#   4. Open the JSON file, copy the ENTIRE content
#   5. Paste it here as a single line (minify it first):
#      node -e "const s=require('./serviceAccountKey.json'); console.log(JSON.stringify(s))"
#   6. NEVER commit the raw JSON file to git (add it to .gitignore)
#
# Example format (replace with your real values):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
FIREBASE_SERVICE_ACCOUNT=PASTE_YOUR_SERVICE_ACCOUNT_JSON_HERE_AS_ONE_LINE
