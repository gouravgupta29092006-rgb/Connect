# ─── Frontend Environment ────────────────────────────────────────────────────
# These values are used at build time and runtime by Next.js.

# Backend API URL (only needed if NOT using the Next.js rewrite proxy)
# In development, the proxy in next.config.mjs handles /api/* → localhost:5000
# In production, set this to your deployed backend URL.
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com

# ─── Firebase Client Config ──────────────────────────────────────────────────
# Get these from: Firebase Console → Project Settings → General → Your Apps → Web App
# Firebase Authentication is 100% FREE on the Spark (no-cost) plan.
# Steps:
#   1. Go to https://console.firebase.google.com
#   2. Create a project (free)
#   3. Add a Web App
#   4. Enable Authentication → Sign-in methods → Google + Email/Password
#   5. Copy the config values below

NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
